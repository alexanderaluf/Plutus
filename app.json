{
  "expo": {
    "name": "Plutus",
    "slug": "plutus",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "backgroundColor": "#DCE7E0",
    "scheme": "plutus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.plutus.budgettracker",
      "icon": "./assets/plutus.icon",
      "entitlements": {
        "com.apple.developer.kernel.extended-virtual-addressing": true
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Plutus to record voice messages for private on-device AI chat."
      }
    },
    "android": {
      "package": "com.plutus.budgettracker",
      "backgroundColor": "#DCE7E0",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons-android/adaptive-icon.png",
        "backgroundColor": "#DCE7E0"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Plutus to select profile photos and receipt images.",
          "cameraPermission": false,
          "microphonePermission": "Allow Plutus to record voice messages for private on-device AI chat."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCE7E0",
          "image": "./assets/icons-android/splash-icon-light.png",
          "imageWidth": 100,
          "android": {
            "image": "./assets/icons-android/splash-icon-light.png",
            "dark": {
              "image": "./assets/icons-android/splash-icon-dark.png"
            }
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": {
            "ios": [
              "en",
              "he",
              "ru"
            ],
            "android": [
              "en",
              "he",
              "ru"
            ]
          }
        }
      ],
      "expo-background-task",
      "expo-notifications",
      "expo-image",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Plutus to record a voice message for private on-device AI chat.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "react-native-litert-lm",
      "./plugins/with-local-ai-android-ndk",
      "./plugins/with-local-ai-ios-build",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
