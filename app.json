{
  "expo": {
    "name": "Plutus",
    "slug": "plutus",
    "owner": "project-aurora-ltd",
    "version": "1.0.1",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "backgroundColor": "#DCE7E0",
    "scheme": "plutus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.plutus.budgettracker",
      "icon": "./assets/plutus.icon",
      "entitlements": {
        "com.apple.developer.kernel.extended-virtual-addressing": true,
        "com.apple.security.application-groups": [
          "group.com.plutus.budgettracker"
        ]
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Plutus to record voice messages for private on-device AI chat.",
        "NSSpeechRecognitionUsageDescription": "Allow Plutus to transcribe voice messages on this device for private AI chat.",
        "ExpoLocalization_supportsRTL": true,
        "CFBundleLocalizations": [
          "en",
          "he",
          "ru",
          "en",
          "he",
          "ru"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.plutus.budgettracker",
      "versionCode": 6,
      "backgroundColor": "#DCE7E0",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons-android/adaptive-icon.png",
        "backgroundColor": "#DCE7E0"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Plutus to select profile photos and receipt images.",
          "cameraPermission": false,
          "microphonePermission": "Allow Plutus to record voice messages for private on-device AI chat."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCE7E0",
          "image": "./assets/icons-android/splash-icon-light.png",
          "imageWidth": 100,
          "android": {
            "image": "./assets/icons-android/splash-icon-light.png",
            "dark": {
              "image": "./assets/icons-android/splash-icon-dark.png"
            }
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": {
            "ios": [
              "en",
              "he",
              "ru"
            ],
            "android": [
              "en",
              "he",
              "ru"
            ]
          }
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons-android/notification-icon.png",
          "color": "#087E8B"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Plutus to use Face ID to unlock the app and keep your finances private."
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Plutus to record a voice message for private on-device AI chat.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "react-native-litert-lm",
      "./plugins/with-local-ai-android-ndk",
      "./plugins/with-local-ai-ios-build",
      "./plugins/with-plutus-widgets",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { *; }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class * extends androidx.work.InputMerger { public <init>(); }\n-keep class * extends androidx.work.ListenableWorker { public <init>(android.content.Context, androidx.work.WorkerParameters); }\n-keep class dev.litert.litertlm.** { *; }\n-keep class expo.modules.plutuslocalai.** { *; }\n-keep class expo.modules.plutuswidget.** { *; }"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "dark",
        "hidden": false
      },
      "eas": {
        "projectId": "af452427-6c13-41c5-b1c7-1e188d3ee54a",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "PlutusWidgetExtension",
                  "bundleIdentifier": "com.plutus.budgettracker.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.plutus.budgettracker"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
