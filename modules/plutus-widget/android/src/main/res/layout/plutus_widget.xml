<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/plutus_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:padding="4dp">

  <LinearLayout
    android:id="@+id/plutus_widget_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/plutus_widget_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <!-- Row 1: Header with icon badge, title, account count, and profile switcher pill -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/plutus_widget_badge_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/plutus_widget_icon_badge"
        android:gravity="center"
        android:text="◈"
        android:textColor="@color/plutus_widget_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/plutus_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="Total balance"
        android:textColor="@color/plutus_widget_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/plutus_widget_account_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/plutus_widget_preview_count"
        android:textColor="@color/plutus_widget_muted"
        android:textSize="11sp" />

      <LinearLayout
        android:id="@+id/plutus_widget_profile_button"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:background="@drawable/plutus_widget_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <TextView
          android:id="@+id/plutus_widget_profile_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:maxWidth="110dp"
          android:singleLine="true"
          android:text="@string/plutus_widget_preview_profile"
          android:textColor="@color/plutus_widget_foreground"
          android:textSize="11sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>

    <!-- Hero Balance -->
    <TextView
      android:id="@+id/plutus_widget_balance"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:singleLine="true"
      android:text="@string/plutus_widget_preview_balance"
      android:textColor="@color/plutus_widget_foreground"
      android:textSize="24sp"
      android:textStyle="bold" />

    <!-- Assets vs Liabilities Labels + Gradient Capsule Bar -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/plutus_widget_assets_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/plutus_widget_preview_assets"
        android:textColor="@color/plutus_widget_income_text"
        android:textSize="11sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/plutus_widget_debt_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/plutus_widget_preview_debt"
        android:textColor="@color/plutus_widget_muted"
        android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
      android:id="@+id/plutus_widget_assets_bar"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="6dp"
      android:layout_marginTop="4dp"
      android:indeterminate="false"
      android:max="100"
      android:progress="88"
      android:progressDrawable="@drawable/plutus_widget_progress" />

    <!-- Row 2: Inner Card with Monthly Income/Expense + Account State -->
    <LinearLayout
      android:id="@+id/plutus_widget_inner_card"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="8dp"
      android:layout_weight="1"
      android:background="@drawable/plutus_widget_inner_card"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingLeft="12dp"
      android:paddingRight="12dp"
      android:paddingTop="6dp"
      android:paddingBottom="6dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Monthly Income Column -->
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingRight="8dp">

          <TextView
            android:id="@+id/plutus_widget_income_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Month income"
            android:textColor="@color/plutus_widget_muted"
            android:textSize="10sp" />

          <TextView
            android:id="@+id/plutus_widget_income_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/plutus_widget_preview_income"
            android:textColor="@color/plutus_widget_income_text"
            android:textSize="13sp"
            android:textStyle="bold" />
        </LinearLayout>

        <!-- Monthly Expense Column -->
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingLeft="8dp">

          <TextView
            android:id="@+id/plutus_widget_expense_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Month expense"
            android:textColor="@color/plutus_widget_muted"
            android:textSize="10sp" />

          <TextView
            android:id="@+id/plutus_widget_expense_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/plutus_widget_preview_expense"
            android:textColor="@color/plutus_widget_expense_text"
            android:textSize="13sp"
            android:textStyle="bold" />
        </LinearLayout>
      </LinearLayout>

      <TextView
        android:id="@+id/plutus_widget_accounts_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/plutus_widget_preview_accounts"
        android:textColor="@color/plutus_widget_muted"
        android:textSize="10sp" />
    </LinearLayout>

    <!-- Row 3: Two Action Buttons (Create Income & Create Expense) -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="36dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <LinearLayout
        android:id="@+id/plutus_widget_btn_income"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="5dp"
        android:layout_weight="1"
        android:background="@drawable/plutus_widget_btn_income"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <TextView
          android:id="@+id/plutus_widget_btn_income_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:singleLine="true"
          android:text="+ Create income"
          android:textColor="@color/plutus_widget_income_text"
          android:textSize="12sp"
          android:textStyle="bold" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/plutus_widget_btn_expense"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="5dp"
        android:layout_weight="1"
        android:background="@drawable/plutus_widget_btn_expense"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <TextView
          android:id="@+id/plutus_widget_btn_expense_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:singleLine="true"
          android:text="− Create expense"
          android:textColor="@color/plutus_widget_expense_text"
          android:textSize="12sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>

  </LinearLayout>
</FrameLayout>

